  "item": [
    {
      "name": "1 Auth",
      "item": [
        {
          "name": "Register user A (RF-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailA}}\",\n  \"password\": \"Secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailA', 'a-' + Date.now() + '@test.local');",
                  "pm.collectionVariables.set('emailB', 'b-' + Date.now() + '@test.local');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('role is USER (BR-62)', () => pm.expect(b.user.role).to.eql('USER'));",
                  "pm.test('no password hash', () => pm.expect(b.user).to.not.have.property('passwordHash'));",
                  "pm.collectionVariables.set('token', b.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register same email \u2192 409 (BR-60)",
